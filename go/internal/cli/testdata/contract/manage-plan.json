{
  "dryRun": true,
  "scope": "user",
  "actions": [
    {
      "kind": "copy_skill",
      "from": "/tmp/src/alpha",
      "to": "/tmp/agents/skills/alpha",
      "skill_key": "alpha"
    },
    {
      "kind": "remove_mcp_agent",
      "path": "/tmp/cursor/mcp.json",
      "agent": "cursor",
      "server": "demo"
    },
    {
      "kind": "record_origin",
      "path": "/tmp/agents/.skill-lock.json",
      "skill_key": "alpha",
      "source": "o/r"
    },
    {
      "kind": "forget_origin",
      "path": "/tmp/agents/.skill-lock.json",
      "skill_key": "beta"
    }
  ],
  "notes": []
}

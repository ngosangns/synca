{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "source",
    "slug",
    "audits"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "audits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "slug",
          "status",
          "summary",
          "auditedAt"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "summary": {
            "type": "string"
          },
          "auditedAt": {
            "type": "string"
          },
          "riskLevel": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "required": ["code", "exit", "message"],
      "properties": {
        "code": {
          "enum": [
            "failed-generic",
            "usage",
            "unavailable",
            "protocol",
            "failed",
            "needs-confirm",
            "unauthorized",
            "conflict"
          ]
        },
        "exit": {"type": "integer", "enum": [1, 2, 3, 4, 5, 6, 7, 8]},
        "message": {"type": "string"},
        "hint": {"type": "string"}
      }
    }
  }
}

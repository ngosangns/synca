{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "source",
    "slug",
    "installs",
    "hash",
    "files"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "installs": {
      "type": [
        "integer",
        "null"
      ]
    },
    "hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "contents": {
            "type": "string"
          }
        }
      }
    }
  }
}

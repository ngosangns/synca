{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "schemaVersion", "commands", "error"],
  "properties": {
    "name": {"enum": ["synca"]},
    "schemaVersion": {"type": "integer", "enum": [1]},
    "commands": {
      "type": "object",
      "required": [
        "skills list",
        "skills install",
        "skills remove",
        "skills search",
        "skills browse",
        "skills official",
        "skills info",
        "skills audit",
        "skills use",
        "skills discover",
        "skills update",
        "skills restore",
        "skills init",
        "mcp list",
        "mcp add",
        "mcp remove",
        "mcp probe",
        "mcp search",
        "mcp browse",
        "mcp info",
        "mcp install",
        "sync skills",
        "sync mcp",
        "sync all",
        "sync hooks",
        "hooks list",
        "hooks add",
        "hooks remove",
        "hooks untrust",
        "hooks sync",
        "provider clear",
        "providers list",
        "doctor",
        "skill install",
        "skill check",
        "update",
        "version",
        "schema"
      ],
      "additionalProperties": {"$ref": "#/$defs/command"}
    },
    "error": {"type": "object"}
  },
  "$defs": {
    "command": {
      "type": "object",
      "required": ["summary", "mutates", "destructive", "flags", "output"],
      "properties": {
        "summary": {"type": "string"},
        "mutates": {"type": "boolean"},
        "destructive": {"type": "boolean"},
        "flags": {"type": "array", "items": {"type": "string"}},
        "output": {"type": ["object", "null"]}
      }
    }
  }
}

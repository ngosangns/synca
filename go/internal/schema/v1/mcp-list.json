{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["key", "scope", "presence", "mismatch", "source", "source_type", "source_version"],
    "properties": {
      "key": {"type": "string"},
      "scope": {"enum": ["user", "project"]},
      "presence": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["agent", "path", "normalized", "fingerprint"],
          "properties": {
            "agent": {
              "enum": ["agents", "grok", "devin", "kiro", "opencode", "claude", "cursor"]
            },
            "path": {"type": "string"},
            "normalized": {
              "type": "object",
              "required": ["transport", "command", "url", "args", "enabled", "env_keys", "header_keys"],
              "properties": {
                "transport": {"type": "string"},
                "command": {"type": ["array", "null"], "items": {"type": "string"}},
                "url": {
                  "description": "Server URL. A userinfo password is \"••••••\" unless mcp list --reveal.",
                  "type": ["string", "null"]
                },
                "args": {
                  "description": "Arguments. A secret-looking value (--token=…, Authorization) is \"••••••\" unless --reveal.",
                  "type": ["array", "null"],
                  "items": {"type": "string"}
                },
                "enabled": {"type": ["boolean", "null"]},
                "env_keys": {"type": "array", "items": {"type": "string"}},
                "env": {
                  "description": "Env entries. Every value is \"••••••\" unless mcp list --reveal. Keys match env_keys.",
                  "type": "object",
                  "additionalProperties": {"type": "string"}
                },
                "header_keys": {"type": "array", "items": {"type": "string"}},
                "headers": {
                  "description": "Remote header values. Every value is \"••••••\" unless mcp list --reveal. Keys match header_keys.",
                  "type": "object",
                  "additionalProperties": {"type": "string"}
                }
              }
            },
            "fingerprint": {"type": "string"}
          }
        }
      },
      "mismatch": {"type": "boolean"},
      "source": {
        "description": "Registry name recorded at install, or null for a server not installed from a registry.",
        "type": ["string", "null"]
      },
      "source_type": {"enum": ["registry", null]},
      "source_version": {"type": ["string", "null"]}
    }
  }
}
